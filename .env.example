# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (já está no .gitignore).

MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=ferrofluid_db
MYSQL_USER=ferrofluid_app
MYSQL_PASSWORD=troque-esta-senha

# Usados pelo backend para se conectar ao serviço mysql do docker-compose
MYSQL_HOST=mysql
MYSQL_PORT=3306
